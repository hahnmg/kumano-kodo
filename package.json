{
    "name": "kumano-kodo-design-system",
    "private": true,
    "type": "module",
    "scripts": {
        "tokens": "node scripts/build-tokens.mjs",
        "storybook": "storybook dev -p 6006",
        "build": "npm run tokens && node scripts/check-contrast.mjs && storybook build -o storybook-static --quiet",
        "build:typo3": "npm run tokens && node scripts/build-typo3.mjs",
        "export:demo": "node scripts/export-demo.mjs",
        "lint": "eslint . && stylelint \"stories/**/*.css\" \"src/**/*.css\" && node scripts/check-filenames.mjs && prettier --check \"**/*.{ts,mjs,css,json}\"",
        "size": "node scripts/check-size.mjs",
        "test": "npm run tokens && vitest run",
        "images": "node scripts/build-images.mjs"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@storybook/addon-docs": "^10.6.0",
        "@storybook/html-vite": "^10.6.0",
        "axe-core": "^4.13.0",
        "eslint": "^10.11.0",
        "globals": "^17.12.0",
        "jsdom": "^30.1.1",
        "prettier": "^3.9.9",
        "sharp": "^0.35.5",
        "storybook": "^10.6.0",
        "stylelint": "^17.15.0",
        "stylelint-config-standard": "^40.0.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.71.0",
        "vite": "^8.3.1",
        "vitest": "^5.0.2"
    }
}
