{
	"name": "kumano-kodo-design-system",
	"private": true,
	"type": "module",
	"scripts": {
		"tokens": "node scripts/build-tokens.mjs",
		"storybook": "storybook dev -p 6006",
		"build": "npm run tokens && node scripts/check-contrast.mjs && node scripts/build-usage.mjs && storybook build -o storybook-static --quiet",
		"build:typo3": "npm run tokens && node scripts/build-typo3.mjs && node scripts/build-docs.mjs",
		"export:demo": "node scripts/export-demo.mjs",
		"export:starter": "node scripts/export-starter.mjs",
		"docs:feature": "node scripts/build-feature.mjs",
		"docs": "docker run --rm -v \"$PWD/typo3/packages/kumano_kodo\":/project ghcr.io/typo3-documentation/render-guides:latest --config=Documentation",
		"lint": "eslint . && stylelint \"stories/**/*.css\" \"src/**/*.css\" && node scripts/check-filenames.mjs && node scripts/check-fluid.mjs && prettier --check \"**/*.{ts,mjs,css,json,md}\"",
		"size": "node scripts/check-size.mjs",
		"test": "npm run tokens && vitest run",
		"images": "node scripts/build-images.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@storybook/addon-docs": "^10.6.0",
		"@storybook/html-vite": "^10.6.0",
		"axe-core": "^4.13.0",
		"eslint": "^10.11.0",
		"fontkit": "^2.0.4",
		"globals": "^17.12.0",
		"js-yaml": "^4.3.2",
		"jsdom": "^30.1.1",
		"prettier": "^3.9.9",
		"sharp": "^0.35.5",
		"storybook": "^10.6.0",
		"stylelint": "^17.15.0",
		"stylelint-config-standard": "^40.0.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.0",
		"vite": "^8.3.1",
		"vitest": "^5.0.2"
	}
}
