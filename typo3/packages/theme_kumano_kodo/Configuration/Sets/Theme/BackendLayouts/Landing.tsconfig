mod.web_layout.BackendLayouts {
  Landing {
    title = LLL:theme_kumano_kodo.backend_layouts:layout.landing
    icon = EXT:theme_kumano_kodo/Resources/Public/Images/BackendLayouts/landing.png
    config {
      backend_layout {
        colCount = 2
        rowCount = 4
        rows {
          1 {
            columns {
              1 {
                name = LLL:theme_kumano_kodo.backend_layouts:column.topbar
                colPos = 30
                identifier = topbar
                colspan = 2
                slideMode = slide
                allowedContentTypes = header
              }
            }
          }
          2 {
            columns {
              1 {
                name = LLL:theme_kumano_kodo.backend_layouts:column.main
                colPos = 0
                identifier = main
                colspan = 2
              }
            }
          }
          3 {
            columns {
              1 {
                name = LLL:theme_kumano_kodo.backend_layouts:column.footer
                colPos = 20
                identifier = footer
                colspan = 2
                slideMode = slide
                allowedContentTypes = text, kumano_list
              }
            }
          }
          4 {
            columns {
              1 {
                name = LLL:theme_kumano_kodo.backend_layouts:column.footerNotice
                colPos = 21
                identifier = footerNotice
                colspan = 1
                slideMode = slide
                allowedContentTypes = kumano_callout
              }
              2 {
                name = LLL:theme_kumano_kodo.backend_layouts:column.footerLegal
                colPos = 22
                identifier = footerLegal
                colspan = 1
                slideMode = slide
                allowedContentTypes = kumano_list
              }
            }
          }
        }
      }
    }
  }
}
