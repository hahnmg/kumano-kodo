{
    "name": "kumano-kodo/sitepackage",
    "description": "Kumano Kodo - Sitepackage built from the Kumano Kodo design system",
    "type": "typo3-cms-extension",
    "license": "proprietary",
    "version": "0.1.0",
    "require": {
        "b13/container": "^4.1",
        "typo3/cms-core": "^14.3",
        "typo3/cms-fluid": "^14.3",
        "typo3/cms-frontend": "^14.3",
        "typo3/cms-rte-ckeditor": "^14.3"
    },
    "autoload": {
        "psr-4": {
            "KumanoKodo\\Sitepackage\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "kumano_kodo",
            "Package": {
                "providesPackages": {}
            }
        }
    }
}
