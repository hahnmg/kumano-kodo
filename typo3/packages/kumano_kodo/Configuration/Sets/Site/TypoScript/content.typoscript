lib.contentElement = FLUIDTEMPLATE
lib.contentElement {
  layoutRootPaths.10 = EXT:kumano_kodo/Resources/Private/Templates/Layouts/
  partialRootPaths.10 = EXT:kumano_kodo/Resources/Private/Templates/Partials/
  templateRootPaths.10 = EXT:kumano_kodo/Resources/Private/Templates/Content/

  # kumano_link_list renders Content/KumanoLinkList.fluid.html.
  templateName.cObject = TEXT
  templateName.cObject {
    field = CType
    required = 1
    case = uppercamelcase
  }

  dataProcessing.10 = record-transformation

  # Site settings the elements need; content templates do not see the page's settings.
  settings.newsletterTarget = {$kumanoKodo.newsletter.target}
  settings.upright = {$kumanoKodo.brand.upright}
}

tt_content = CASE
tt_content.key.field = CType
tt_content.default =< lib.contentElement

# Containers get their columns as content areas (EXT:container), rendered like the page's own areas.
tt_content.kumano_section < lib.contentElement
tt_content.kumano_section.dataProcessing.20 = container-content-area
tt_content.kumano_section.dataProcessing.20.as = columns

tt_content.kumano_columns < tt_content.kumano_section

tt_content.kumano_chapter < lib.contentElement
tt_content.kumano_chapter.dataProcessing.20 = kumano-chapter-number
