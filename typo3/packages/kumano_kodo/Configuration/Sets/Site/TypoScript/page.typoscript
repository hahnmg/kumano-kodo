page = PAGE
page {
  10 = PAGEVIEW
  10 {
    paths.10 = EXT:kumano_kodo/Resources/Private/Templates/

    dataProcessing {
      10 = menu
      10 {
        levels = 1
        as = mainNavigation
        dataProcessing.10 = record-transformation
      }

      20 = language-menu
      20 {
        languages = auto
        as = languageNavigation
      }

      5 = kumano-theme
      5.as = theme

      # The current page as a record, so its relations (the header chips) resolve.
      6 = menu
      6 {
        special = list
        special.value.data = page:uid
        includeNotInMenu = 1
        as = currentPage
        dataProcessing.10 = record-transformation
      }

      30 = menu
      30 {
        special = rootline
        # Pages hidden from the navigation, such as the days overview, still belong to the trail.
        includeNotInMenu = 1
        as = breadcrumb
      }

      40 = kumano-structured-data
    }
  }
}

# "Page – Site", the page first since it is what tells two tabs of one site apart.
config.pageTitleFirst = 1
config.pageTitleSeparator = –
config.pageTitleSeparator.noTrimWrap = | | |

config.htmlTag.attributes {
  data-theme = {$kumanoKodo.theme}
  data-scheme = {$kumanoKodo.scheme}
}

# A site's own templates come before the theme's, file by file.
["{$kumanoKodo.templates.path}" != ""]
  page.10.paths.20 = {$kumanoKodo.templates.path}
  lib.contentElement {
    templateRootPaths.20 = {$kumanoKodo.templates.path}Content/
    partialRootPaths.20 = {$kumanoKodo.templates.path}Partials/
    layoutRootPaths.20 = {$kumanoKodo.templates.path}Layouts/
  }
[END]
