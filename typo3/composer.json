{
	"name": "kumano-kodo/site",
	"description": "Kumano Kodo - TYPO3 installation running the sitepackage and its demo",
	"type": "project",
	"license": "proprietary",
	"repositories": [
		{
			"type": "path",
			"url": "packages/*"
		}
	],
	"require": {
		"php": "^8.2",
		"b13/container": "^4.1",
		"georgringer/news": "^14.1",
		"kumano-kodo/demo": "@dev",
		"kumano-kodo/sitepackage": "@dev",
		"typo3/cms-backend": "^14.3",
		"typo3/cms-belog": "^14.3",
		"typo3/cms-core": "^14.3",
		"typo3/cms-extbase": "^14.3",
		"typo3/cms-felogin": "^14.3",
		"typo3/cms-filelist": "^14.3",
		"typo3/cms-fluid": "^14.3",
		"typo3/cms-form": "^14.3",
		"typo3/cms-frontend": "^14.3",
		"typo3/cms-impexp": "^14.3",
		"typo3/cms-indexed-search": "^14.3",
		"typo3/cms-info": "^14.3",
		"typo3/cms-install": "^14.3",
		"typo3/cms-lowlevel": "^14.3",
		"typo3/cms-rte-ckeditor": "^14.3",
		"typo3/cms-seo": "^14.3",
		"typo3/cms-setup": "^14.3",
		"typo3/cms-tstemplate": "^14.3"
	},
	"config": {
		"allow-plugins": {
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"platform": {
			"php": "8.2.0"
		},
		"sort-packages": true
	},
	"minimum-stability": "stable",
	"prefer-stable": true,
	"scripts": {
		"cs": "php-cs-fixer fix --dry-run --diff",
		"cs:fix": "php-cs-fixer fix",
		"demo:export": "Build/Scripts/demo-export.sh",
		"starter:export": "Build/Scripts/starter-export.sh"
	},
	"require-dev": {
		"typo3/coding-standards": "^0.9.0"
	}
}
